@model MovieApp.Models.Movie
@{
    ViewData["Title"] = "Add Movie";
}
<h1>@ViewData["Title"]</h1>
<form asp-action="Create" method="post">
    <div class="form-group mb-2">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" style="padding:8px;" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="Genre"></label>
        <input asp-for="Genre" class="form-control" style="padding:8px;" />
        <span asp-validation-for="Genre" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="Year"></label>
        <input asp-for="Year" class="form-control" style="padding:8px;" />
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="Director"></label>
        <input asp-for="Director" class="form-control" style="padding:8px;" />
        <span asp-validation-for="Director" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
